# Database (docker compose up -d starts one on this URL)
DATABASE_URL=postgres://querent:querent@localhost:5432/querent

# Public base URL of the app, used in sign-in links and OAuth redirects
APP_URL=http://localhost:3000

# Contact email sent to Crossref in the User-Agent ("polite pool")
CROSSREF_MAILTO=you@example.com

# Email delivery for sign-in links (optional in development:
# without it, links are printed to the server console)
RESEND_API_KEY=
EMAIL_FROM="Querent <hello@example.com>"

# ORCID sign-in (optional). Register at https://orcid.org/developer-tools
# Use https://sandbox.orcid.org while testing.
ORCID_BASE_URL=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
